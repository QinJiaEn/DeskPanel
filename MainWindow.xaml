<Window x:Class="DeskPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DeskPanel.Converters"
        Title="DeskPanel" Height="620" Width="960"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:CategoryColorConverter x:Key="CategoryColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <!-- 主容器：圆角 + 阴影 + 白色毛玻璃背景 -->
    <Border x:Name="MainBorder" CornerRadius="14" Background="#E8F5F5F5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ===== Row 0: 标题栏 ===== -->
            <Border Grid.Row="0" Background="#FAFAFA" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="DeskPanel" Foreground="#0078D4"
                               FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="Alt+` 呼出 · Esc 隐藏 · 拖拽收纳"
                               Foreground="#AAAAAA" FontFamily="Microsoft YaHei UI" FontSize="10"
                               VerticalAlignment="Center" Margin="110,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button x:Name="BtnCollectDesktop"
                                Content="收纳桌面" Style="{StaticResource AccentButton}"
                                FontSize="11" Padding="10,4" Margin="0,0,8,0"
                                Click="BtnCollectDesktop_Click" ToolTip="一键收纳桌面所有文件"/>
                        <Button x:Name="BtnSettings"
                                Content="&#xE713;" Style="{StaticResource IconButton}"
                                Width="32" Height="32" FontSize="12"
                                Click="BtnSettings_Click" ToolTip="设置"/>
                        <Button Content="&#xE10A;" Style="{StaticResource IconButton}"
                                Width="32" Height="32" FontSize="12"
                                Click="BtnClose_Click" ToolTip="关闭面板"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Row 1: 搜索栏 ===== -->
            <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBox x:Name="TxtSearch" Tag="搜索文件..."
                             Background="#FFFFFF" Foreground="#1A1A1A"
                             CaretBrush="#0078D4" BorderBrush="#E0E0E0"
                             FontFamily="Microsoft YaHei UI" FontSize="13"
                             VerticalAlignment="Center" Padding="10,6"
                             TextChanged="TxtSearch_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock x:Name="TbSearchHintEmpty" Text="🔍  搜索文件..."
                               Foreground="#AAAAAA" FontFamily="Microsoft YaHei UI" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TxtSearch,Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=TxtSearch,Path=Text}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ===== Row 2: 主内容区（分类列表 + 文件网格） ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 分类侧边栏 -->
                <Border Grid.Column="0" Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CategoryPanel" Margin="8,8,8,0"/>
                        </ScrollViewer>

                        <!-- 底部分类操作 -->
                        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                Padding="8" Background="#F0F0F0">
                            <Button Content="+ 添加分类" Style="{StaticResource IconButton}"
                                    FontFamily="Microsoft YaHei UI" FontSize="11"
                                    Foreground="#0078D4" HorizontalAlignment="Stretch"
                                    Click="BtnAddCategory_Click"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Background="#E0E0E0"/>

                <!-- 文件网格区域（支持拖放） -->
                <Border Grid.Column="2" Background="#F5F5F5"
                        AllowDrop="True"
                        DragEnter="FileGrid_DragEnter"
                        DragOver="FileGrid_DragOver"
                        DragLeave="FileGrid_DragLeave"
                        Drop="FileGrid_Drop">
                    <Grid>
                        <!-- 拖放提示覆盖层 -->
                        <Border x:Name="DropOverlay" Background="#200078D4"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="释放文件到此收纳"
                                       Foreground="#0078D4" FontFamily="Microsoft YaHei UI"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 分类选择覆盖层（拖放时弹出） -->
                        <Border x:Name="CategoryPickerOverlay" Background="#CCFAFAFA"
                                Visibility="Collapsed">
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="20"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="400">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="选择收纳分类" Foreground="#1A1A1A"
                                               FontFamily="Microsoft YaHei UI" FontSize="14"
                                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="CategoryPickerList"/>
                                    <Button Content="取消" Style="{StaticResource IconButton}"
                                            FontFamily="Microsoft YaHei UI" FontSize="12"
                                            Foreground="#E74856" HorizontalAlignment="Right"
                                            Margin="0,10,0,0"
                                            Click="BtnCancelCategoryPick_Click"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- 文件网格 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="FileGridPanel" Margin="8"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Row 3: 状态栏 ===== -->
            <Border Grid.Row="3" Background="#F0F0F0" CornerRadius="0,0,14,14"
                    BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="TbStatus" Text="共 0 个文件"
                               Foreground="#888888" FontFamily="Microsoft YaHei UI"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Fluent Design · DeskPanel"
                               Foreground="#CCCCCC" FontFamily="Microsoft YaHei UI"
                               FontSize="10" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
